#!/usr/bin/env bash
# Pre-push hook: bloqueia push com o gate de varredura vermelho.
cd "$(git rev-parse --show-toplevel)"
if [ "${SKIP_WOIL_VERIFY:-0}" = "1" ]; then
  echo "woil-verify: PULADO via SKIP_WOIL_VERIFY=1 (uso consciente)"
  exit 0
fi
echo "woil-verify: rodando gate pré-push..."
bash scripts/verify.sh || {
  echo "woil-verify: gate VERMELHO — push abortado."
  echo "Corrija as etapas falhas, ou use SKIP_WOIL_VERIFY=1 git push para forçar."
  exit 1
}
